# Copier ce fichier en .env si vous voulez modifier ces valeurs.

# URL de l'API. Laisser vide pour passer par le proxy Vite (/api).
VITE_API_URL=http://localhost:5000/api

# Rappel du compte admin sur la page de connexion, en developpement uniquement.
# Laisser vide pour ne rien afficher.
# Exemple : VITE_DEMO_ADMIN=votre.email@exemple.bj / votre_mot_de_passe
VITE_DEMO_ADMIN=
