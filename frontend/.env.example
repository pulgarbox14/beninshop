# =====================================================================
#  Ce fichier est facultatif. Sans .env, l'application fonctionne deja.
#  Pour le personnaliser :  cp .env.example .env
# =====================================================================


# ---------------------------------------------------------------------
#  A GARDER TEL QUEL
# ---------------------------------------------------------------------

# Adresse de l'API. Correspond au PORT du backend.
VITE_API_URL=http://localhost:5000/api


# ---------------------------------------------------------------------
#  FACULTATIF  (laisser vide si vous n'en voulez pas)
# ---------------------------------------------------------------------

# Rappel du compte admin affiche sur la page de connexion, uniquement
# pendant le developpement (npm run dev). Jamais visible en production.
# Exemple : VITE_DEMO_ADMIN=admin@maboutique.bj / monMotDePasse
VITE_DEMO_ADMIN=
