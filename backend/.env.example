# Copier ce fichier en .env puis remplacer les valeurs d'exemple.
# Le fichier .env n'est jamais envoye sur GitHub.

# Port du serveur Express
PORT=5000

# Connexion MongoDB (la base mini_ecommerce est creee automatiquement)
MONGO_URI=mongodb://127.0.0.1:27017/mini_ecommerce

# Cle de signature des JWT : une longue chaine aleatoire, propre a votre projet.
# Exemple de generation : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_chaine_aleatoire

# Duree de validite du token (7d = 7 jours, 24h, 30m...)
JWT_EXPIRES_IN=7d

# Adresse du frontend autorisee par le CORS
CLIENT_URL=http://localhost:5173

# Compte administrateur cree par "npm run seed".
# Choisissez vos propres valeurs : ce sont vos identifiants de connexion au tableau de bord.
ADMIN_NAME=Prenom Nom
ADMIN_EMAIL=votre.email@exemple.bj
ADMIN_PASSWORD=votre_mot_de_passe_6_caracteres_minimum
