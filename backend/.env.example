# Port du serveur Express
PORT=5000

# Connexion MongoDB (base : mini_ecommerce)
MONGO_URI=mongodb://127.0.0.1:27017/mini_ecommerce

# Clé secrète utilisée pour signer les JWT
JWT_SECRET=beninshop_secret_key_a_changer
JWT_EXPIRES_IN=7d

# Origine autorisee pour le CORS (frontend Vite)
CLIENT_URL=http://localhost:5173
