# Port du serveur Express
PORT=5000

# Connexion MongoDB (base : mini_ecommerce)
MONGO_URI=mongodb://127.0.0.1:27017/mini_ecommerce

# Clé secrète utilisée pour signer les JWT (mettre une valeur longue et aléatoire)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origine autorisee pour le CORS (frontend Vite)
CLIENT_URL=http://localhost:5173

# Compte administrateur cree par "npm run seed" : a renseigner dans votre .env
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
