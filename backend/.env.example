# =====================================================================
#  Copier ce fichier :  cp .env.example .env
#  Le fichier .env n'est jamais envoye sur GitHub.
# =====================================================================


# ---------------------------------------------------------------------
#  A GARDER TEL QUEL  (valeurs de developpement, rien a changer)
# ---------------------------------------------------------------------

# Port du serveur Express
PORT=5000

# Connexion MongoDB locale. La base mini_ecommerce est creee automatiquement.
MONGO_URI=mongodb://127.0.0.1:27017/mini_ecommerce

# Duree de validite du token (7d = 7 jours, 24h, 30m...)
JWT_EXPIRES_IN=7d

# Adresse du frontend Vite, autorisee par le CORS
CLIENT_URL=http://localhost:5173


# ---------------------------------------------------------------------
#  A REMPLACER PAR VOS VALEURS  (les 4 lignes ci-dessous)
# ---------------------------------------------------------------------

# Cle de signature des JWT : une longue chaine aleatoire.
# Generer la votre :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Compte administrateur cree par "npm run seed".
# Ce sont VOS identifiants de connexion au tableau de bord.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
